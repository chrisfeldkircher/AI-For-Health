# licensed / external raw data (not redistributable)
/dataset/
/ComParE2017_Cold_4students.zip

# course materials / reference papers (may be copyrighted)
*.pdf

# caches (huge, regenerable from dataset + code)
# but keep pseudo-speaker TSVs under version control — they encode the
# clustering assumption for A5.5 / A6 / A7 and are small
/cache/*
!/cache/pseudo_speakers/
# Locked predict-time artifacts: the 5 A2.5 audit-derived-prior head
# checkpoints (~2.9 MB each, <100 MB GitHub limit) + the frozen probe/beta/
# tau bundle (~28 KB). These make the hidden-test predict cell portable
# (Mac) with no multi-GB train/devel cache. Re-include the dir, re-ignore
# its contents, then whitelist exactly these files.
!/cache/microsoft_wavlm-large/
/cache/microsoft_wavlm-large/*
!/cache/microsoft_wavlm-large/head_A2grouped_honestprior_seed42.pt
!/cache/microsoft_wavlm-large/head_A2grouped_honestprior_seed123.pt
!/cache/microsoft_wavlm-large/head_A2grouped_honestprior_seed7.pt
!/cache/microsoft_wavlm-large/head_A2grouped_honestprior_seed999.pt
!/cache/microsoft_wavlm-large/head_A2grouped_honestprior_seed31337.pt
!/cache/microsoft_wavlm-large/predict_artifacts_multiK.npz
# second cache location appears inside model/ because notebooks cwd is there
/model/cache/

# local model checkpoints (binary, regenerable)
/checkpoints/

# claude tooling / project settings
/.claude/

# python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
env/
venv/

# jupyter
.ipynb_checkpoints/

# OS / IDE
.DS_Store
Thumbs.db
desktop.ini
@eaDir/
.vscode/
.idea/

# backups
*.bak
*.json.bak

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.log
*.out
*.synctex.gz
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk

# paper figures: track the deterministic PDF build-inputs (regenerable from
# paper_data/ + results/ via paper/figures/make_figures.py), but not the
# PNG inspection copies or the built main.pdf
!paper/figures/*.pdf
paper/figures/*.png
